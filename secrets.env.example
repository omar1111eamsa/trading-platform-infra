# Copy this file to secrets.env and fill real values.
# secrets.env is ignored by git.

# Portainer admin credentials
PORTAINER_URL=https://127.0.0.1:9443
PORTAINER_USER=admin
PORTAINER_ADMIN_PASSWORD=change-me

# GitHub token used by Portainer to read SysteM repo and by CI secret sync
SYSTEM_REPO_TOKEN=change-me
# Optional: if empty, setup script falls back to SYSTEM_REPO_TOKEN
GITHUB_TOKEN=

# SysteM GitOps source
SYSTEM_REPO=https://github.com/Trading-Terminal2025/SysteM
SYSTEM_REF=refs/heads/new-infra

# GitHub org + target repos for secret propagation
ORG=Trading-Terminal2025
TARGET_REPOS="stable-backend- UI-Terminal- terminal-dashboard"

# Optional cleanup of old secrets in app repos
CLEAN_LEGACY_SECRETS=false
