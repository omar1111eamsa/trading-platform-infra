$username = "${admin_user}"
$plainPassword = "${admin_password}"

# Disable WDDM graphics driver for RDP to prevent DWM crashes
$registryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
if (-not (Test-Path $registryPath)) {
    New-Item -Path $registryPath -Force
}
New-ItemProperty -Path $registryPath -Name "fEnableWddmDriver" -Value 0 -PropertyType DWord -Force

# Install and configure OpenSSH Server
Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0
Set-Service -Name sshd -StartupType 'Automatic'
Start-Service sshd

try {
    $securePassword = ConvertTo-SecureString $plainPassword -AsPlainText -Force
    $existingUser = Get-LocalUser -Name $username -ErrorAction SilentlyContinue

    if (-not $existingUser) {
        New-LocalUser -Name $username -Password $securePassword -FullName $username -Description "Primary admin user created by Terraform startup script"
    }

    Add-LocalGroupMember -Group "Administrators" -Member $username -ErrorAction SilentlyContinue
    Set-LocalUser -Name $username -PasswordNeverExpires $true
} catch {
    Write-Error $_
    exit 1
}
