region            = "eu-west-1"
availability_zone = "eu-west-1a"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

ssh_key_name = "my-key-pair"

# Ansible: SSH user on Canonical Ubuntu AMIs; path to private key for generated inventory + optional auto-provision
linux_ssh_user                 = "ubuntu"
ansible_ssh_private_key_path   = "~/.ssh/my-key-pair.pem"
ansible_provision              = false

linux_vm_name      = "trading-platform-vm"
linux_instance_type = "t3.large"
linux_disk_size_gb  = 80

windows_vm_name       = "mt5-worker-vm"
windows_instance_type = "t3.large"
windows_disk_size_gb  = 50
windows_instance_count = 1

windows_admin_user     = "hodeconlimited"
windows_admin_password = "ChangeMe123!ChangeMe123!"

frontend_domain_name = "dashboard.example.com"
backend_domain_name  = "api.example.com"
terminal_domain_name = "terminal.example.com"

ssh_source_ranges = ["0.0.0.0/0"]
rdp_source_ranges = ["0.0.0.0/0"]
